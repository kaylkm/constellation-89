@{
    Layout = null;
    ViewData["Title"] = "Вхід в адмінпанель";
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Constellation 89</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #0a0a0f;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }
        .login-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(139,92,246,0.3);
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 0 40px rgba(139,92,246,0.15);
        }
        .login-logo {
            font-size: 1.1rem;
            font-weight: 700;
            color: #a78bfa;
            letter-spacing: 0.05em;
            text-align: center;
            margin-bottom: 0.25rem;
        }
        .login-title {
            color: #e2e8f0;
            font-size: 1.5rem;
            font-weight: 600;
            text-align: center;
            margin-bottom: 1.75rem;
        }
        .form-label { color: #94a3b8; font-size: 0.875rem; margin-bottom: 0.35rem; }
        .form-control {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(139,92,246,0.25);
            color: #e2e8f0;
            border-radius: 8px;
            padding: 0.6rem 0.85rem;
        }
        .form-control:focus {
            background: rgba(255,255,255,0.08);
            border-color: #8b5cf6;
            color: #e2e8f0;
            box-shadow: 0 0 0 3px rgba(139,92,246,0.2);
        }
        .form-control::placeholder { color: #475569; }
        .btn-login {
            background: linear-gradient(135deg, #7c3aed, #4f46e5);
            border: none;
            color: #fff;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.65rem;
            width: 100%;
            transition: opacity .2s;
        }
        .btn-login:hover { opacity: 0.88; color: #fff; }
        .alert-danger {
            background: rgba(239,68,68,0.12);
            border: 1px solid rgba(239,68,68,0.3);
            color: #fca5a5;
            border-radius: 8px;
            font-size: 0.875rem;
        }
        .back-link { color: #64748b; font-size: 0.8rem; text-decoration: none; }
        .back-link:hover { color: #a78bfa; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">✦ Constellation 89</div>
        <div class="login-title">Адмінпанель</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-3">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label class="form-label">Логін</label>
                <input type="text" name="username" class="form-control" placeholder="admin" autocomplete="username" required />
            </div>
            <div class="mb-4">
                <label class="form-label">Пароль</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-login">Увійти</button>
        </form>

        <div class="text-center mt-3">
            <a href="/" class="back-link">← На головну</a>
        </div>
    </div>
</body>
</html>
