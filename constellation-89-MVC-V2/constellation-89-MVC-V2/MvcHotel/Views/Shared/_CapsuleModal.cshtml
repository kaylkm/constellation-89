<div class="modal-overlay" id="modal-overlay" onclick="handleOverlayClick(event)">
    <div class="modal" id="modal-box">
        <button class="modal-close" type="button" onclick="closeModal()">✕</button>
        <div class="modal-img" id="modal-img">
            <span class="modal-badge" id="modal-badge"></span>
        </div>
        <div class="modal-body">
            <div class="modal-title" id="modal-title"></div>
            <div class="modal-subtitle" id="modal-subtitle"></div>
            <p class="modal-desc" id="modal-desc"></p>
            <ul class="modal-amenities" id="modal-amenities"></ul>
            <div class="modal-footer">
                <div class="modal-price">
                    <span class="price-from">від </span>
                    <span class="price-amount" id="modal-price"></span>
                    <span class="price-per"> /ніч</span>
                </div>
            </div>
        </div>
    </div>
</div>