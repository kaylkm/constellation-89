@model IEnumerable<HotelBooking.Models.Review>

@{
    ViewData["Title"] = "Відгуки";
}

<h2>Відгуки</h2>

<form method="post" action="/Reviews/Create">
    <div class="form-group">
        <label>Ваше ім'я:</label>
        <input type="text" name="authorName" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Відгук:</label><br />
        <textarea name="text" rows="4" cols="50" class="form-control" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Залишити відгук</button>
</form>

<hr />

@if (Model != null && Model.Any())
{
    @foreach (var review in Model)
    {
                <div style="border: 1px solid #ddd; padding: 10px; margin-bottom: 10px; border-radius: 5px;">
                    <strong>@review.User?.Name</strong> 
                    <p>@review.Text</p>
                    <p><small class="text-muted">Дата: @review.CreatedAt.LocalDateTime</small></p>

                    <form method="post" action="/Reviews/Delete/@review.Id" style="display:inline">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Видалити цей відгук?')">Видалити</button>
                    </form>
                </div>
    }
}
else
{
        <p>Відгуків поки немає. Будьте першим!</p>
}