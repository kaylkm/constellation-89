@model HotelBooking.Models.Review

@{
    ViewData["Title"] = "Редагувати відгук";
}

<h2>Редагувати відгук</h2>

@if (Model?.User != null)
{
        <p>Автор: <strong>@Model.User.Name</strong></p>
}

<form method="post" action="/Reviews/Edit/@Model.Id">
    <div class="form-group">
        <label>Текст відгуку:</label><br />
        <textarea name="text" rows="4" cols="50" class="form-control" required>@Model.Text</textarea>
    </div>
    <br />
    <button type="submit" class="btn btn-success">Зберегти зміни</button>
</form>

<hr />
<a href="/Reviews" class="btn btn-secondary">Назад до списку</a>