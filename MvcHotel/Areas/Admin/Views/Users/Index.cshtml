@model List<MvcHotel.Data.Entities.User>
@{
    ViewData["Title"] = "Користувачі";
}

<div class="page-card">
    <div class="page-card-header">
        <span class="page-card-title">Усі користувачі (@Model.Count)</span>
        <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn-admin btn-primary-admin">+ Додати</a>
    </div>
    <div style="overflow-x:auto;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ім'я</th>
                    <th>Відгуків</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td style="color:var(--muted);">@u.Id</td>
                        <td style="font-weight:600;">@u.Name</td>
                        <td>
                            <span style="background:rgba(139,92,246,0.12); color:var(--accent); padding:2px 10px; border-radius:20px; font-size:.8rem; font-weight:700;">
                                @u.Reviews.Count
                            </span>
                        </td>
                        <td style="white-space:nowrap;">
                            <a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@u.Id" class="btn-admin btn-secondary-admin" style="margin-right:4px;">Деталі</a>
                            <a asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@u.Id" class="btn-admin btn-primary-admin" style="margin-right:4px;">Ред.</a>
                            <a asp-area="Admin" asp-controller="Users" asp-action="Delete" asp-route-id="@u.Id" class="btn-admin btn-danger-admin">Видалити</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" style="text-align:center; color:var(--muted); padding:2rem;">Користувачів немає</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
