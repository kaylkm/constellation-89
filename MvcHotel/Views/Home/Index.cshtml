@* ========== ВІДГУКИ ========== *@
<section class="reviews" id="reviews">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">✦ Гості про нас</span>
            <h2 class="section-title">Відгуки</h2>
        </div>

        <div class="reviews-grid">
            @foreach (var review in Model.Reviews)
            {
                <div class="review-card @(review.IsHighlighted ? "review-card--highlight" : "")">
                    <div class="review-overall-label">Загальне враження:</div>
                    <div class="review-stars">@(new string('★', review.Rating))</div>
                    <p class="review-text">"@review.Text"</p>

                    @if (review.Cleanliness.HasValue || review.Staff.HasValue || review.PriceQuality.HasValue)
                    {
                        <div class="review-ratings">
                            @if (review.Cleanliness.HasValue)
                            {
                                <div class="review-rating-item">
                                    <span class="review-rating-label">Чистота</span>
                                    <span class="review-rating-stars">@(new string('★', review.Cleanliness.Value))@(new string('☆', 5 - review.Cleanliness.Value))</span>
                                </div>
                            }
                            @if (review.Staff.HasValue)
                            {
                                <div class="review-rating-item">
                                    <span class="review-rating-label">Персонал</span>
                                    <span class="review-rating-stars">@(new string('★', review.Staff.Value))@(new string('☆', 5 - review.Staff.Value))</span>
                                </div>
                            }
                            @if (review.PriceQuality.HasValue)
                            {
                                <div class="review-rating-item">
                                    <span class="review-rating-label">Ціна/Якість</span>
                                    <span class="review-rating-stars">@(new string('★', review.PriceQuality.Value))@(new string('☆', 5 - review.PriceQuality.Value))</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="review-author">
                        <div class="author-avatar av1">@review.AvatarLetter</div>
                        <div>
                            <strong>@review.Author</strong>
                            <span>@review.CityAndDate</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(review.AdminReply))
                    {
                        <div class="review-hotel-reply">
                            <div class="review-hotel-reply__label">✦ Відповідь готелю</div>
                            <p class="review-hotel-reply__text">@review.AdminReply</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

